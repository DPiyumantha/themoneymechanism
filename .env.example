# Copy this file to .env and fill it in. .env is in .gitignore — never commit your key.
# Get a key: Google AI Studio › Get API key. Use a project with billing enabled for monetized videos.
GEMINI_API_KEY=
# Optional: pin a TTS model (run `npm run voice -- --list-models` to see yours). Empty = newest stable one.
GEMINI_TTS_MODEL=
